{
  "name": "shopnow-qa-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node app/check-node.mjs",
    "dev": "tsx app/server/index.ts",
    "predev": "node app/check-node.mjs",
    "reset": "tsx app/server/reset.ts",
    "test": "playwright test",
    "pretest": "node app/check-node.mjs",
    "test:ui": "playwright test --ui",
    "postinstall": "playwright install chromium",
    "test:api": "playwright test --grep @api",
    "test:browser": "playwright test --grep @ui",
    "test:p1": "playwright test --grep @P1",
    "test:controls": "playwright test --grep-invert BUG-",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "perf": "node perf/latency.mjs",
    "evidence": "node evidence/record-evidence.mjs",
    "traceability": "node scripts/traceability.mjs",
    "docs:animation": "node docs/scenes/export.mjs"
  },
  "dependencies": {
    "express": "4.21.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
